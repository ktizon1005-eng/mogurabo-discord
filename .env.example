# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=ここにBotトークン

# 投稿先。#📢｜業務連絡 内の「出勤確認」スレッドのID
# （通常のチャンネルIDを入れてもそのまま動く）
CHANNEL_ID=1529357135698464878

# サーバーID（ログ表示用）
GUILD_ID=1454016637748379732

# 投稿タイミング（cron形式 / Asia/Tokyo）: 毎日20:00
CRON_SCHEDULE=0 20 * * *

# 冒頭に付けるメンション（空にすればメンションなし）
MENTION=@everyone
